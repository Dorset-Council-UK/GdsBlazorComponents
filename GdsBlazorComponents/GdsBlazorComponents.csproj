<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>4.1.0</Version>
		<Authors>Dorset Council</Authors>
		<Company>Dorset Council</Company>
		<Description>Blazor components styled to match GOV.UK Design System.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageId>Dorset-Council-UK.GdsBlazorComponents</PackageId>
		<RepositoryUrl>https://github.com/Dorset-Council-UK/GdsBlazorComponents</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<EnableDefaultContentItems>true</EnableDefaultContentItems>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<Target Name="BuildNpmPackagesBeforeBuildInDebug" BeforeTargets="build" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="npm run build:dev" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

</Project>
