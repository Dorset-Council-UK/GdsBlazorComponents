<div class="@_class" @attributes="@AdditionalAttributes">

    <div class="govuk-accordion__section-header">
        <GdsHeading Level="@AccordionHeadingLevel" BaseCssClass="govuk-accordion__section-heading">
            <span id="@_headingId" class="govuk-accordion__section-button">
                @SectionTitle
            </span>
        </GdsHeading>
        @if (!string.IsNullOrEmpty(SummaryText))
        {
            <div id="@_summaryId" class="govuk-accordion__section-summary govuk-body">
                @SummaryText
            </div>
        }
    </div>

    <div id="@_contentId" class="govuk-accordion__section-content">
        @Content
    </div>

</div>

@code {
    [CascadingParameter]
    public GdsAccordion.AccordionContext? Accordion { get; set; }

    [Parameter, EditorRequired]
    public string SectionTitle { get; set; }

    [Parameter]
    public string? SummaryText { get; set; }

    [Parameter]
    public int AccordionHeadingLevel { get; set; } = 2;

    [Parameter, EditorRequired]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public string? AdditionalCssClasses { get; set; }

    [Parameter]
    public bool IsExpanded { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? _class;
    private int? _index;
    private string? _headingId;
    private string? _summaryId;
    private string? _contentId;

    protected override void OnInitialized()
    {
        if (Accordion is null)
        {
            throw new InvalidOperationException($"A {nameof(GdsAccordionSection)} must be a child of a {nameof(GdsAccordion)}.");
        }
        if (_index is null)
        {
            _index = Accordion.NextIndex();
            _headingId = $"{Accordion.AccordionId}-heading-{_index}";
            _summaryId = $"{Accordion.AccordionId}-summary-{_index}";
            _contentId = $"{Accordion.AccordionId}-content-{_index}";
        }
    }

    protected override void OnParametersSet()
    {
        _class = new CssClassBuilder("govuk-accordion__section")
            .Add(AdditionalCssClasses)
            .AddIf(IsExpanded, "govuk-accordion__section--expanded")
            .Build();
    }
}