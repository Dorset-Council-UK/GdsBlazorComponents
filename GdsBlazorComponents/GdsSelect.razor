@typeparam T
@inherits InputSelect<T>

<select
    id="@_resolvedId"
    name="@NameAttributeValue"
    class="@_class"
    @attributes="AdditionalAttributes"
    @bind="CurrentValueAsString"
    @bind:event="onchange"
    aria-describedby="@CascadedFieldContext?.DescribedBy">
    @ChildContent
</select>
