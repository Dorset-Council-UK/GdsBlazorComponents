@if (Show && (ShowDay || ShowMonth || ShowYear))
{
    <GdsFieldsetGroup AdditionalCssClasses="@AdditionalCssClasses" @attributes="@AdditionalAttributes">
        @if (Heading != null)
        {
            <GdsFieldsetLegend Size="@LegendSize">
                @Heading
            </GdsFieldsetLegend>
        }

        @if (Hint != null)
        {
            <GdsHint>@Hint</GdsHint>
        }

        <GdsErrorMessage />

        @if (_gdsDate is not null)
        {
            <div class="govuk-date-input" id="@_resolvedId">
                @if (ShowDay)
                {
                    <div class="govuk-date-input__item">
                        <GdsFormGroup RegisterWithParent>
                            <GdsDateLabel Text="Day" />
                            <GdsInputText Id="@_dayId" name="@_dayName" @bind-Value="_gdsDate.DayText" autocomplete="@_dayAutocomplete" inputmode="numeric" class="@InputDateCssClasses.Day" />
                        </GdsFormGroup>
                    </div>
                }
                @if (ShowMonth)
                {
                    <div class="govuk-date-input__item">
                        <GdsFormGroup RegisterWithParent>
                            <GdsDateLabel Text="Month" />
                            <GdsInputText Id="@_monthId" name="@_monthName" @bind-Value="_gdsDate.MonthText" autocomplete="@_monthAutocomplete" inputmode="numeric" class="@InputDateCssClasses.Month" />
                        </GdsFormGroup>
                    </div>
                }
                @if (ShowYear)
                {
                    <div class="govuk-date-input__item">
                        <GdsFormGroup RegisterWithParent>
                            <GdsDateLabel Text="Year" />
                            <GdsInputText Id="@_yearId" name="@_yearName" @bind-Value="_gdsDate.YearText" autocomplete="@_yearAutocomplete" inputmode="numeric" class="@InputDateCssClasses.Year" />
                        </GdsFormGroup>
                    </div>
                }
            </div>
        }
    </GdsFieldsetGroup>
}
