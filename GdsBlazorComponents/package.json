{
  "name": "gds-blazor-components",
  "version": "5.0.0-beta.1",
  "description": "Blazor components styled to match GOV.UK Design System.",
  "repository": "https://github.com/Dorset-Council-UK/GdsBlazorComponents",
  "author": "Dorset Council",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --mode production --config webpack.prod.js",
    "build:dev": "webpack --mode development --config webpack.dev.js",
    "watch": "webpack --config webpack.dev.js --watch",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated"
  },
  "dependencies": {
    "govuk-frontend": "5.14.0"
  },
  "devDependencies": {
    "@types/govuk-frontend": "5.12.0",
    "@types/node": "26.6.5",
    "css-loader": "7.1.5",
    "mini-css-extract-plugin": "2.10.2",
    "sass": "1.105.1",
    "sass-loader": "17.0.1",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-merge": "6.0.1"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "-vs-binding": {
    "ProjectOpened": [
      "watch",
      "build:dev"
    ],
    "BeforeBuild": [
      "build:dev"
    ]
  }
}
