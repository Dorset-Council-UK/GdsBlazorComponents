@inherits InputText

<input id="@FormGroupContext?.Id"
       name="@NameAttributeValue"
       @attributes="AdditionalAttributes"
       class="@CssClass"
       @bind-Value="CurrentValueAsString"
       @bind-Value:event="onchange"
       aria-describedby="@FormGroupContext?.DescribedBy"
       />

@code {
    [CascadingParameter]
    private GdsFormGroupContext? FormGroupContext { get; set; }
}