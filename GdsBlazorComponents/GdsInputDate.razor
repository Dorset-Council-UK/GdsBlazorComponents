@if (Show)
{
    <GdsFieldsetGroup AdditionalCssClasses="@AdditionalCssClasses" @attributes="@AdditionalAttributes">
        @if (Heading != null)
        {
            <GdsFieldsetLegend Size="@LegendSize">
                @Heading
            </GdsFieldsetLegend>
        }

        @if (Hint != null)
        {
            <GdsHint>@Hint</GdsHint>
        }

        <GdsErrorMessage />

        @if (_gdsDate is not null)
        {
            <div class="govuk-date-input" id="@_resolvedId">
                <div class="govuk-date-input__item">
                    <GdsFormGroup>
                        <GdsDateLabel Text="Day" />
                        <GdsInputText Id="@_dayId" name="@_dayName" @bind-Value="_gdsDate.DayText" autocomplete="@_dayAutocomplete" inputmode="numeric" class="@_dayCssClass" />
                    </GdsFormGroup>
                </div>
                <div class="govuk-date-input__item">
                    <GdsFormGroup>
                        <GdsDateLabel Text="Month" />
                        <GdsInputText Id="@_monthId" name="@_monthName" @bind-Value="_gdsDate.MonthText" autocomplete="@_monthAutocomplete" inputmode="numeric" class="@_monthCssClass" />
                    </GdsFormGroup>
                </div>
                <div class="govuk-date-input__item">
                    <GdsFormGroup>
                        <GdsDateLabel Text="Year" />
                        <GdsInputText id="@_yearId" name="@_yearName" @bind-Value="_gdsDate.YearText" autocomplete="@_yearAutocomplete" inputmode="numeric" class="@_yearCssClass" />
                    </GdsFormGroup>
                </div>
            </div>
        }
    </GdsFieldsetGroup>
}
