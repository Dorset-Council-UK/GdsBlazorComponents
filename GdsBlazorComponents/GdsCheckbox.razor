@typeparam T
@attribute [Obsolete("Deprecated in v3.5.0. Use GdsInputCheckbox instead. It will be removed in future versions.")]

@if (Option.IsExclusive)
{
    <GdsCheckboxDivider />
}

<GdsCheckboxItem>
    <GdsInputCheckbox Id="@Option.Id"
                      Name="@Name"
                      Exclusive="@Option.IsExclusive"
                      ConditionalId="@ConditionalId"
                      @bind-Value="@Option.Selected"
                      @bind-Value:after="HandleOnChange"
                      @attributes="AdditionalAttributes" />
    <GdsCheckboxLabel Text="@Option.Label" />
    @if (Option.Hint is not null)
    {
        <GdsCheckboxHint>@Option.Hint</GdsCheckboxHint>
    }
</GdsCheckboxItem>

@code {
    [Parameter, EditorRequired]
    public required GdsOptionItem<T> Option { get; set; }

    [Parameter]
    public string? ConditionalId { get; set; }

    [Parameter]
    public string? AdditionalCssClasses { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public EventCallback<GdsOptionItem<T>> OnChanged { get; set; }

    protected override void OnInitialized()
    {
        if (Option is null)
        {
            throw new InvalidOperationException($"The {GetType()} component needs to be provided with an Options parameter of type GdsOptionItem.");
        }
    }

    private Task HandleOnChange() => OnChanged.HasDelegate ? OnChanged.InvokeAsync(Option) : Task.CompletedTask;
}
